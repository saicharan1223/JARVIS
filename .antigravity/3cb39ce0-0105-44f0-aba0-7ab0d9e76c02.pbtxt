    content: "import { TacticalRadarModule } from \'./components/TacticalRadarModule\';\nimport { ProtocolMatrixModal } from \'./components/ProtocolMatrixModal\';\nimport { HandsFreeStudio } from \'./components/HandsFreeStudio\';\nimport { sound } from \'./utils/soundEffects\';\nimport { speech } from \'./utils/speech\';\n\nexport default function App() {\n  const [userTitle, setUserTitle] = useState(\'Sir\');\n  const [suitModel, setSuitModel] = useState(\'Mark LXXXV\');\n  const [powerLevel, setPowerLevel] = useState(100);\n  const [currentProtocol, setCurrentProtocol] = useState(\'Standard Operations\');\n  const [activeTab, setActiveTab] = useState<\'handsfree\' | \'command\' | \'armory\' | \'power\' | \'radar\'>(\'handsfree\');\n\n  const [isSpeaking, setIsSpeaking] = useState(false);\n  const [isProcessing, setIsProcessing] = useState(false);\n  const [isListening, setIsListening] = useState(false);\n  const [voiceEnabled, setVoiceEnabled] = useState(true);\n  const [soundEnabled, setSoundEnabled] = useState(true);\n  const [isProtocolModalOpen, setIsProtocolModalOpen] = useState(false);\n\n  // Initial welcome message from J.A.R.V.I.S.\n  const [messages, setMessages] = useState<ChatMessage[]>([\n    {\n      id: \'init-1\',\n      sender: \'jarvis\',\n      text: `Good morning, Sir. All Stark core systems are online and calibrated at 99.4% efficiency. Mark LXXXV nanotech matrices are standing by, and secure orbital relays are active. How may I be of assistance today?`,\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n    },\n  ]);\n\n  // Sync vocal state from speech controller\n  useEffect(() => {\n    const unsubscribe = speech.subscribeSpeaking((speaking) => {\n      setIsSpeaking(speaking);\n    });\n    return () => unsubscribe();\n  }, []);\n\n  // Update speech controller configuration\n  useEffect(() => {\n    speech.voiceEnabled = voiceEnabled;\n  }, [voiceEnabled]);\n\n  useEffect(() => {\n    sound.isMuted = !soundEnabled;\n  }, [soundEnabled]);\n\n  // Send message to J.A.R.V.I.S. backend\n  const handleSendMessage = async (text: string) => {\n    const userMsg: ChatMessage = {\n      id: `msg-${Date.now()}-u`,\n      sender: \'user\',\n      text,\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n    };\n\n    setMessages((prev) => [...prev, userMsg]);\n    setIsProcessing(true);\n\n    try {\n      const historyPayload = messages.slice(-6).map((m) => ({\n        role: m.sender === \'user\' ? (\'user\' as const) : (\'model\' as const),\n        text: m.text,\n      }));\n\n      const res = await fetch(\'/api/chat\', {"
