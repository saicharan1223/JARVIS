    content: "            speech.speakText(notify.text);\n          }\n        }}\n        voiceEnabled={voiceEnabled}\n        onToggleVoice={() => setVoiceEnabled(!voiceEnabled)}\n        soundEnabled={soundEnabled}\n        onToggleSound={() => setSoundEnabled(!soundEnabled)}\n        onOpenProtocols={() => setIsProtocolModalOpen(true)}\n        suitModel={suitModel}\n      />\n\n      {/* Main HUD Viewport */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto p-3 sm:p-4 md:p-6 flex flex-col gap-4\">\n        {/* Navigation Tabs */}\n        <div className=\"flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar border-b border-cyan-500/20\">\n          {[\n            { id: \'handsfree\', label: \'\360\237\223\261 Hands-Free Simulator & Studio\', icon: Smartphone },\n            { id: \'command\', label: \'Tactical Command\', icon: Terminal },\n            { id: \'armory\', label: \'Stark Armory\', icon: Shield },\n            { id: \'power\', label: \'Power Matrix\', icon: Zap },\n            { id: \'radar\', label: \'Tactical Radar\', icon: RadarIcon },\n          ].map((tab) => {\n            const Icon = tab.icon;\n            const isActive = activeTab === tab.id;\n            return (\n              <button\n                key={tab.id}\n                onClick={() => {\n                  sound.playClick();\n                  setActiveTab(tab.id as any);\n                }}\n                className={`flex items-center gap-2 px-4 py-2 rounded-t-lg font-orbitron font-semibold text-xs tracking-wider uppercase transition border-t border-x ${\n                  isActive\n                    ? \'bg-slate-900/90 text-cyan-300 border-cyan-400/60 shadow-[0_-4px_12px_rgba(0,240,255,0.2)]\'\n                    : \'bg-slate-950/40 text-slate-400 border-transparent hover:text-slate-200 hover:bg-slate-900/40\'\n                }`}\n              >\n                <Icon className={`w-3.5 h-3.5 ${isActive ? \'text-cyan-400\' : \'text-slate-500\'}`} />\n                <span>{tab.label}</span>\n              </button>\n            );\n          })}\n\n          <div className=\"ml-auto hidden sm:flex items-center gap-3 text-xs font-mono-code text-cyan-400/80 pr-2\">\n            <span className=\"flex items-center gap-1.5\">\n              <span className=\"w-2 h-2 rounded-full bg-cyan-400 animate-pulse\" />\n              STATUS: <strong className=\"text-white\">{currentProtocol}</strong>\n            </span>\n          </div>\n        </div>\n\n        {/* Tab Content Display */}\n        <div className=\"flex-1 min-h-[580px] grid grid-cols-1 gap-4\">\n          {activeTab === \'handsfree\' && <HandsFreeStudio />}\n\n          {activeTab === \'command\' && (\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-4 h-full\">\n              {/* Left Column: Arc Reactor Core Telemetry Centerpiece */}\n              <div className=\"lg:col-span-5 bg-slate-950/70 border border-cyan-500/30 rounded-xl p-4 flex flex-col justify-between items-center backdrop-blur-md shadow-2xl relative overflow-hidden\">\n                {/* Corner decorative HUD brackets */}\n                <div className=\"absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-cyan-400/60 pointer-events-none\" />"
