    content: "import React, { useState, useEffect } from \'react\';\nimport {\n  Volume2,\n  VolumeX,\n  Mic,\n  Radio,\n  Shield,\n  Activity,\n  Sliders,\n  Sparkles,\n  Settings,\n  HelpCircle,\n} from \'lucide-react\';\nimport { sound } from \'../utils/soundEffects\';\n\ninterface HudHeaderProps {\n  userTitle: string;\n  onUserTitleChange: (title: string) => void;\n  voiceEnabled: boolean;\n  onToggleVoice: () => void;\n  soundEnabled: boolean;\n  onToggleSound: () => void;\n  onOpenProtocols: () => void;\n  suitModel: string;\n}\n\nexport const HudHeader: React.FC<HudHeaderProps> = ({\n  userTitle,\n  onUserTitleChange,\n  voiceEnabled,\n  onToggleVoice,\n  soundEnabled,\n  onToggleSound,\n  onOpenProtocols,\n  suitModel,\n}) => {\n  const [time, setTime] = useState(new Date());\n  const [elapsedSeconds, setElapsedSeconds] = useState(384);\n  const [showSettings, setShowSettings] = useState(false);\n\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setTime(new Date());\n      setElapsedSeconds((s) => s + 1);\n    }, 1000);\n    return () => clearInterval(timer);\n  }, []);\n\n  const formatElapsedTime = (sec: number) => {\n    const hrs = Math.floor(sec / 3600).toString().padStart(2, \'0\');\n    const mins = Math.floor((sec % 3600) / 60).toString().padStart(2, \'0\');\n    const s = (sec % 60).toString().padStart(2, \'0\');\n    return `${hrs}:${mins}:${s}`;\n  };\n\n  const titles = [\'Sir\', \'Boss\', \'Tony\', \'Doctor\', \'Commander\'];\n\n  return (\n    <header className=\"relative z-30 w-full border-b border-cyan-500/20 bg-slate-950/80 backdrop-blur-md px-4 py-2.5\">\n      <div className=\"max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3\">"
    num_lines: 235
