tic flux or overclock plasma output.\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Right Column: Conversational CommandCenter & Terminal */}\\n              <div className=\\\"lg:col-span-7 h-full min-h-[480px]\\\">\\n                <CommandCenter\\n                  messages={messages}\\n                  onSendMessage={handleSendMessage}\\n                  isProcessing={isProcessing}\\n                  isSpeaking={isSpeaking}\\n                  userTitle={userTitle}\\n                  suitModel={suitModel}\\n                  onInitiateProtocol={(name) => {\\n                    handleSendMessage(`Initiate ${name}`);\\n                  }}\\n                />\\n              </div>\\n            </div>\\n          )}\\n\\n          {activeTab === \'armory\' && (\\n            <ArmoryModule\\n              selectedSuit={suitModel}\\n              onSelectSuit={(suit) => {\\n                setSuitModel(suit);\\n                const suitAlert: ChatMessage = {\\n                  id: `msg-${Date.now()}`,\\n                  sender: \'jarvis\',\\n                  text: `Platform switched to ${suit}, ${userTitle}. Telemetry linked and pre-flight diagnostics verified.`,\\n                  timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n                };\\n                setMessages((prev) => [...prev, suitAlert]);\\n              }}\\n            />\\n          )}\\n\\n          {activeTab === \'power\' && (\\n            <PowerMatrixModule\\n              powerLevel={powerLevel}\\n              onPowerChange={(level) => setPowerLevel(level)}\\n              userTitle={userTitle}\\n            />\\n          )}\\n\\n          {activeTab === \'radar\' && <TacticalRadarModule />}\\n        </div>\\n      </main>\\n\\n      {/* Protocol Override Matrix Modal */}\\n      <ProtocolMatrixModal\\n        isOpen={isProtocolModalOpen}\\n        onClose={() => setIsProtocolModalOpen(false)}\\n        onExecuteProtocol={handleExecuteProtocol}\\n        userTitle={userTitle}\\n      />\\n\\n      {/* Voice Biometric Security Gate (Locks app until voiceprint matches) */}\\n      <VoiceBiometricGate\\n        isLocked={isBiometricLocked}\\n        onUnlock={() => setIsBiometricLocked(false)}\\n        userTitle={userTitle}\\n        voicePersona={voicePersona}\\n      />\\n    </div>\\n  );\\n}\",\"TargetFile\":\"/src/App.tsx\",\"toolAction\":\"Updating App.tsx navigation and viewports\",\"toolSummary\":\"Update App.tsx with motion tabs and mobile bottom dock\"}"
