  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect, useRef } from \'react\';\nimport {\n  Smartphone,\n  Download,\n  X,\n  Share2,\n  Copy,\n  Check,\n  QrCode,\n  CheckCircle,\n  ExternalLink,\n  Shield,\n  Mic,\n  Eye,\n  SlidersHorizontal,\n} from \'lucide-react\';\nimport QRCode from \'qrcode\';\nimport { usePWAInstall } from \'../utils/usePWAInstall\';\nimport { sound } from \'../utils/soundEffects\';\n\nexport const PWAInstallButton: React.FC = () => {\n  const { isInstallable, isInstalled, isIOS, install } = usePWAInstall();\n  const [showGuide, setShowGuide] = useState(false);\n  const [copied, setCopied] = useState(false);\n  const [qrDataUrl, setQrDataUrl] = useState<string>(\'\');\n  const [activePlatform, setActivePlatform] = useState<\'android\' | \'ios\'>(isIOS ? \'ios\' : \'android\');\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n\n  const currentUrl = typeof window !== \'undefined\' ? window.location.href : \'\';\n\n  useEffect(() => {\n    if (showGuide && currentUrl) {\n      QRCode.toDataURL(currentUrl, {\n        width: 180,\n        margin: 1,\n        color: {\n          dark: \'#06b6d4\',\n          light: \'#020617\',\n        },\n      })\n        .then((url) => setQrDataUrl(url))\n        .catch((err) => console.error(\'QR code generation error:\', err));\n    }\n  }, [showGuide, currentUrl]);\n\n  const handleCopy = () => {\n    sound.playClick();\n    if (navigator.clipboard && currentUrl) {\n      navigator.clipboard.writeText(currentUrl);\n      setCopied(true);\n      setTimeout(() => setCopied(false), 2500);\n    }\n  };\n\n  const handleInstallClick = async () => {\n    sound.playClick();\n    if (isInstallable) {\n      const outcome = await install();\n      if (!outcome) {\n        setShowGuide(true);\n      }\n    } else {\n      setShowGuide(true);\n    }\n  };\n\n  return (\n    <>\n      {isInstalled ? (\n        <button\n          onClick={() => setShowGuide(true)}\n          className=\"flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-950/70 border border-emerald-500/50 text-emerald-300 text-xs font-mono-code hover:bg-emerald-900/60 transition shadow-[0_0_10px_rgba(16,185,129,0.2)]\"\n          title=\"Running in Standalone Mobile Mode. Click for settings.\"\n        >\n          <CheckCircle className=\"w-3.5 h-3.5 text-emerald-400\" />\n          <span className=\"font-bold hidden xs:inline\">APP INSTALLED</span>\n          <span className=\"xs:hidden font-bold\">INSTALLED</span>\n        </button>\n      ) : (\n        <button\n          onClick={handleInstallClick}\n          className=\"flex items-center gap-1.5 px-2.5 py-1 rounded bg-gradient-to-r from-emerald-900/90 to-cyan-900/90 hover:from-emerald-800 hover:to-cyan-800 border border-emerald-400/60 text-emerald-200 text-xs font-mono-code transition shadow-[0_0_12px_rgba(16,185,129,0.35)] active:scale-95\"\n          title=\"Install as native Mobile App on your phone\"\n        >\n          <Smartphone className=\"w-3.5 h-3.5 text-emerald-400 animate-pulse\" />\n          <span className=\"font-bold tracking-wider\">INSTALL ON MOBILE</span>\n        </button>\n      )}\n\n      {/* Mobile Install Tactical Guide Modal */}\n      {showGuide && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/85 backdrop-blur-md animate-fade-in overflow-y-auto\">\n          <div className=\"relative w-full max-w-lg rounded-2xl bg-slate-950 border border-cyan-500/50 p-5 sm:p-6 shadow-[0_0_30px_rgba(6,182,212,0.25)] text-slate-100 scanlines space-y-4 my-auto\">\n            {/* Header */}\n            <div className=\"flex items-center justify-between border-b border-cyan-500/30 pb-3\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"p-1.5 rounded-lg bg-cyan-950/80 border border-cyan-500/40\">\n                  <Smartphone className=\"w-5 h-5 text-cyan-400\" />\n                </div>\n                <div>\n                  <h3 className=\"font-orbitron font-bold text-sm sm:text-base text-white tracking-wider flex items-center gap-2\">\n                    MOBILE APP INSTALLATION\n                    <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-cyan-900/60 text-cyan-300 border border-cyan-500/30\">\n                      PWA\n                    </span>\n                  </h3>\n                  <p className=\"text-[11px] font-mono-code text-cyan-400/80\">\n                    E.D.I.T.H. & J.A.R.V.I.S. Uplink Protocol\n                  </p>\n                </div>\n              </div>\n              <button\n                onClick={() => {\n                  sound.playClick();\n                  setShowGuide(false);\n                }}\n                className=\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-900 border border-transparent hover:border-slate-700 transition\"\n                aria-label=\"Close\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            {/* Direct Instant Action for Android / Supported Browsers */}\n            {isInstallable && (\n              <div className=\"p-3 rounded-xl bg-gradient-to-r from-emerald-950/70 to-cyan-950/70 border border-emerald-500/50 flex flex-col sm:flex-row items-center justify-between gap-3\">\n                <div className=\"text-left\">\n                  <div className=\"text-xs font-bold font-orbitron text-emerald-300\">\n                    1-Tap Instant Installation Ready\n                  </div>\n                  <div className=\"text-[11px] font-mono-code text-slate-300\">\n                    Your browser supports direct installation.\n                  </div>\n                </div>\n                <button\n                  onClick={async () => {\n                    await install();\n                    setShowGuide(false);\n                  }}\n                  className=\"w-full sm:w-auto px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-black font-orbitron font-bold text-xs tracking-wider transition shadow-[0_0_15px_rgba(16,185,129,0.5)] flex items-center justify-center gap-2\"\n                >\n                  <Download className=\"w-4 h-4\" />\n                  INSTALL NOW\n                </button>\n              </div>\n            )}\n\n            {/* QR Code & Shareable Link (For desktop users moving to mobile) */}\n            <div className=\"p-3.5 rounded-xl bg-slate-900/90 border border-cyan-900/50 flex flex-col sm:flex-row items-center gap-4\">\n              <div className=\"flex flex-col items-center justify-center bg-slate-950 p-2 rounded-lg border border-cyan-500/40 shrink-0\">\n                {qrDataUrl ? (\n                  <img\n                    src={qrDataUrl}\n                    alt=\"Scan to open on mobile\"\n                    className=\"w-28 h-28 object-contain rounded\"\n                  />\n                ) : (\n                  <div className=\"w-28 h-28 flex items-center justify-center text-cyan-400 font-mono-code text-[10px]\">\n                    <QrCode className=\"w-8 h-8 animate-pulse\" />\n                  </div>\n                )}\n                <span className=\"text-[9px] font-mono-code text-cyan-400 mt-1 tracking-tight\">\n                  SCAN WITH PHONE CAMERA\n                </span>\n              </div>\n\n              <div className=\"flex-1 w-full space-y-2 text-left\">\n                <div className=\"text-xs font-orbitron font-bold text-slate-200\">\n                  Open on Your Mobile Device\n                </div>\n                <p className=\"text-[11px] font-rajdhani text-slate-300 leading-normal\">\n                  Scan this QR code with your phone camera, or copy this secure link to open in your mobile browser:\n                </p>\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"text\"\n                    readOnly\n                    value={currentUrl}\n                    className=\"flex-1 px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-700 text-[11px] font-mono-code text-cyan-300 truncate selection:bg-cyan-900\"\n                  />\n                  <button\n                    onClick={handleCopy}\n                    className=\"px-3 py-1.5 rounded-lg bg-cyan-900/60 hover:bg-cyan-800 text-cyan-200 border border-cyan-500/40 text-xs font-mono-code flex items-center gap-1.5 transition shrink-0\"\n                  >\n                    {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    <span>{copied ? \'COPIED\' : \'COPY\'}</span>\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            {/* Platform Selection Tabs */}\n            <div className=\"flex border-b border-slate-800 gap-1 text-xs font-orbitron\">\n              <button\n                onClick={() => {\n                  sound.playClick();\n                  setActivePlatform(\'android\');\n                }}\n                className={`flex-1 py-2 text-center rounded-t-lg transition border-b-2 flex items-center justify-center gap-1.5 ${\n                  activePlatform === \'android\'\n                    ? \'border-cyan-400 text-cyan-300 bg-cyan-950/30\'\n                    : \'border-transparent text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                <span>Android (Chrome / Edge / Samsung)</span>\n              </button>\n              <button\n                onClick={() => {\n                  sound.playClick();\n                  setActivePlatform(\'ios\');\n                }}\n                className={`flex-1 py-2 text-center rounded-t-lg transition border-b-2 flex items-center justify-center gap-1.5 ${\n                  activePlatform === \'ios\'\n                    ? \'border-cyan-400 text-cyan-300 bg-cyan-950/30\'\n                    : \'border-transparent text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                <Share2 className=\"w-3.5 h-3.5\" />\n                <span>iPhone / iPad (Safari)</span>\n              </button>\n            </div>\n\n            {/* Step-by-Step Instructions */}\n            <div className=\"text-xs font-rajdhani text-slate-200 leading-relaxed min-h-[140px]\">\n              {activePlatform === \'android\' ? (\n                <div className=\"p-3.5 rounded-xl bg-slate-900/80 border border-cyan-900/40 space-y-2.5\">\n                  <div className=\"flex items-center gap-1.5 font-bold font-orbitron text-xs text-cyan-300\">\n                    <Download className=\"w-3.5 h-3.5 text-cyan-400\" />\n                    <span>Android 3-Step Installation:</span>\n                  </div>\n                  <ol className=\"list-decimal pl-4 space-y-1.5 text-slate-300 text-xs\">\n                    <li>\n                      Open this URL in <strong>Google Chrome</strong> or <strong>Samsung Internet</strong> on your phone.\n                    </li>\n                    <li>\n                      Tap the <strong>three vertical dots (\342\213\256)</strong> in the top-right corner of Chrome.\n                    </li>\n                    <li>\n                      Select <strong>\"Install app\"</strong> (or <strong>\"Add to Home screen\"</strong>).\n                    </li>\n                    <li>\n                      Tap <strong>\"Install\"</strong> in the prompt. The app icon will appear on your app launcher and home screen!\n                    </li>\n                  </ol>\n                </div>\n              ) : (\n                <div className=\"p-3.5 rounded-xl bg-slate-900/80 border border-cyan-900/40 space-y-2.5\">\n                  <div className=\"flex items-center gap-1.5 font-bold font-orbitron text-xs text-sky-300\">\n                    <Share2 className=\"w-3.5 h-3.5 text-sky-400\" />\n                    <span>iOS Safari 3-Step Installation:</span>\n                  </div>\n                  <ol className=\"list-decimal pl-4 space-y-1.5 text-slate-300 text-xs\">\n                    <li>\n                      Open this URL in <strong>Apple Safari</strong> on your iPhone or iPad.\n                    </li>\n                    <li>\n                      Tap the <strong>Share button</strong> (the square icon with the arrow pointing up <span className=\"inline-block px-1 rounded bg-slate-800 text-[10px] font-mono-code border border-slate-700\">\342\216\213</span>) at the bottom toolbar.\n                    </li>\n                    <li>\n                      Scroll down in the share sheet and tap <strong>\"Add to Home Screen\"</strong> (with the <span className=\"text-cyan-300 font-bold\">[+]</span> icon).\n                    </li>\n                    <li>\n                      Tap <strong>\"Add\"</strong> in the top right. E.D.I.T.H. will be placed directly on your iPhone home screen!\n                    </li>\n                  </ol>\n                </div>\n              )}\n            </div>\n\n            {/* Mobile Features & Permissions Callout */}\n            <div className=\"p-3 rounded-xl bg-slate-950/80 border border-slate-800 grid grid-cols-1 sm:grid-cols-3 gap-2 text-[11px] font-mono-code text-slate-300\">\n              <div className=\"flex items-center gap-1.5\">\n                <Mic className=\"w-3.5 h-3.5 text-cyan-400 shrink-0\" />\n                <span>Voice access on launch</span>\n              </div>\n              <div className=\"flex items-center gap-1.5\">\n                <Eye className=\"w-3.5 h-3.5 text-emerald-400 shrink-0\" />\n                <span>Silent facial recognition</span>\n              </div>\n              <div className=\"flex items-center gap-1.5\">\n                <Shield className=\"w-3.5 h-3.5 text-purple-400 shrink-0\" />\n                <span>Standalone full-screen UI</span>\n              </div>\n            </div>\n\n            {/* Close Button */}\n            <button\n              onClick={() => {\n                sound.playClick();\n                setShowGuide(false);\n              }}\n              className=\"w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-slate-200 font-orbitron font-semibold text-xs rounded-xl border border-slate-700 transition\"\n            >\n              GOT IT, CLOSE\n            </button>\n          </div>\n        </div>\n      )}\n    </>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/PWAInstallButton.tsx"
        }
        overwrite: true
      }
    }
