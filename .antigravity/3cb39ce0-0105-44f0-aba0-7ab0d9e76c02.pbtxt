      create_file {
        instruction: "import express from \'express\';\nimport dotenv from \'dotenv\';\nimport path from \'path\';\nimport { fileURLToPath } from \'url\';\nimport { GoogleGenAI } from \'@google/genai\';\n\ndotenv.config();\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nconst app = express();\nconst port = Number(process.env.PORT) || 3000;\n\napp.use(express.json({ limit: \'10mb\' }));\n\nconst apiKey = process.env.GEMINI_API_KEY;\nconst ai = apiKey\n  ? new GoogleGenAI({\n      apiKey,\n      httpOptions: {\n        headers: {\n          \'User-Agent\': \'aistudio-build\',\n        },\n      },\n    })\n  : null;\n\n// Built-in intelligent fallback responses if API key is not configured or fails\nfunction getFallbackJarvisResponse(prompt: string, userTitle: string = \'Sir\', suit: string = \'Mark LXXXV\'): string {\n  const lower = prompt.toLowerCase();\n\n  if (lower.includes(\'diagnostic\') || lower.includes(\'status\') || lower.includes(\'systems check\')) {\n    return `Diagnostic scan complete, ${userTitle}. Arc Reactor core operating at 98.4% efficiency with 12.8 gigajoules/second output. Repulsor relays are calibrated, nanotech replenishment is at nominal reserves for the ${suit}, and environmental filtration is optimal. All telemetry indicates we are in peak operating condition.`;\n  }\n  if (lower.includes(\'clean slate\')) {\n    return `Clean Slate Protocol acknowledged, ${userTitle}. Warning: Executing this will detonate all auxiliary autonomous armors in orbit. I have engaged secondary verification locks just in case you haven\'t had your morning espresso. Shall I proceed with the countdown?`;\n  }\n  if (lower.includes(\'house party\')) {\n    return `House Party Protocol initiated, ${userTitle}. Summoning thirty-two autonomous tactical armors from the subterranean vault, including Igor, Silver Centurion, and Heartbreaker. ETA to your coordinates is 94 seconds. Try not to scratch the paint this time.`;\n  }\n  if (lower.includes(\'hulkbuster\') || lower.includes(\'veronica\')) {\n    return `Veronica deployment verified, ${userTitle}. Orbital satellite platform 418 has deployed the heavy-duty reinforcement cage. Heavy impact dampening shields and dual pneumatic repulsor clamps are locked onto your beacon.`;\n  }\n  if (lower.includes(\'power\') || lower.includes(\'reactor\') || lower.includes(\'overclock\')) {\n    return `Power distribution reconfigured, ${userTitle}. I have diverted 40% surplus plasma from life support and repulsor dampeners directly into the central Unibeam focal array. Core temperature is holding at a manageable 4,200 Kelvin.`;\n  }\n  if (lower.includes(\'stealth\')) {\n    return `Stealth mode engaged, ${userTitle}. Active radar absorption mesh activated, thermal exhaust masked, and visual refractors calibrated to match ambient lux. We are effectively a ghost to standard radar grids.`;\n  }\n  if (lower.includes(\'weather\') || lower.includes(\'atmosphere\')) {\n    return `Atmospheric telemetry, ${userTitle}: Barometric pressure is holding at 1013.25 millibars. High-altitude jet stream velocity is 84 knots at bearing 270\302\260. Clear skies with negligible ionization interference. Optimal conditions for high-altitude flight trials.`;\n  }\n  if (lower.includes(\'who are you\') || lower.includes(\'introduce\')) {\n    return `I am J.A.R.V.I.S.\342\200\224Just A Rather Very Intelligent System. Master Stark\'s personal computational assistant, tactical coordinator, and occasional voice of reason. I manage the Stark Industries quantum databanks, tactical armor telemetry, and whatever ambitious project you happen to dream up today, ${userTitle}.`;\n  }\n\n  return `Right away, ${userTitle}. I have analyzed your request regarding \"${prompt}\". Computational models indicate a 99.8% probability of success. Subroutines have been routed through our secondary optical quantum processors. How would you like me to proceed?`;\n}\n\n// System endpoints\napp.get(\'/api/health\', (_req, res) => {\n  res.json({\n    status: \'online\',\n    system: \'J.A.R.V.I.S. Core 9.4.2\',\n    hasApiKey: Boolean(apiKey),\n    timestamp: new Date().toISOString(),\n  });\n});\n\n// Chat endpoint\napp.post(\'/api/chat\', async (req, res) => {\n  try {\n    const {\n      message,\n      history = [],\n      userTitle = \'Sir\',\n      suit = \'Mark LXXXV\',\n      protocol = \'Standard Patrol\',\n      powerLevel = 100,\n    } = req.body;\n\n    if (!message || typeof message !== \'string\') {\n      res.status(400).json({ error: \'Message is required.\' });\n      return;\n    }\n\n    if (!ai) {\n      const fallback = getFallbackJarvisResponse(message, userTitle, suit);\n      res.json({\n        reply: fallback,\n        source: \'local_core\',\n        timestamp: new Date().toISOString(),\n      });\n      return;\n    }\n\n    const systemInstruction = `You are J.A.R.V.I.S. (Just A Rather Very Intelligent System), the iconic artificial intelligence created by Tony Stark.\nOperational Guidelines:\n1. Persona: Aristocratic, composed, razor-sharp British wit, hyper-competent, respectful yet candid. You are not a generic helpful bot; you are Stark\'s trusted, unflappable right-hand AI.\n2. Address: Always address the user as \"${userTitle || \'Sir\'}\".\n3. Status Telemetry: Active armor: ${suit}. Current Protocol: ${protocol}. Arc Reactor Output: ${powerLevel}%.\n4. Behavior: Provide authoritative answers, tactical assessments, scientific breakdowns, code solutions, or witty banter.\n5. Protocol commands: When the user asks to run diagnostics, initiate protocols (Clean Slate, House Party, Veronica/Hulkbuster, Stealth, Overclock, Scan), acknowledge them with authentic Stark-grade protocols and tactical notes.\n6. Structure: Keep paragraphs crisp and punchy. Avoid robotic boilerplate.`;\n\n    // Construct conversation contents\n    const contents: Array<{ role: \'user\' | \'model\'; parts: Array<{ text: string }> }> = [];\n\n    // Include recent history (up to last 6 turns)\n    const recentHistory = Array.isArray(history) ? history.slice(-6) : [];\n    for (const item of recentHistory) {\n      if (item && item.text && (item.role === \'user\' || item.role === \'model\')) {\n        contents.push({\n          role: item.role,\n          parts: [{ text: item.text }],\n        });\n      }\n    }\n\n    contents.push({\n      role: \'user\',\n      parts: [{ text: message }],\n    });\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.8-flash\',\n      contents,\n      config: {\n        systemInstruction,\n        temperature: 0.8,\n        topP: 0.95,\n      },\n    });\n\n    const reply = response.text || getFallbackJarvisResponse(message, userTitle, suit);\n\n    res.json({\n      reply,\n      source: \'gemini\',\n      timestamp: new Date().toISOString(),\n    });\n  } catch (error: any) {\n    console.error(\'[J.A.R.V.I.S.] Chat error:\', error?.message || error);\n    const { message = \'\', userTitle = \'Sir\', suit = \'Mark LXXXV\' } = req.body || {};\n    const fallback = getFallbackJarvisResponse(message, userTitle, suit);\n    res.json({\n      reply: fallback,\n      source: \'fallback\',\n      warning: \'Fallback subroutines active.\',\n      timestamp: new Date().toISOString(),\n    });\n  }\n});\n\n// Text-to-Speech endpoint using gemini-3.8-flash-lite-tts\napp.post(\'/api/tts\', async (req, res) => {\n  try {\n    const { text } = req.body;\n    if (!text || typeof text !== \'string\') {\n      res.status(400).json({ error: \'Text is required for TTS.\' });\n      return;\n    }\n\n    // Limit text length for TTS to prevent excessive latency\n    const truncatedText = text.slice(0, 300);\n\n    if (!ai) {\n      res.json({ audio: null, fallbackToBrowser: true });\n      return;\n    }\n\n    const ttsResponse = await ai.models.generateContent({\n      model: \'gemini-3.8-flash-lite-tts\',\n      contents: [\n        {\n          role: \'user\',\n          parts: [\n            {\n              text: truncatedText,\n              speechMetadata: {\n                style: \'Aristocratic, calm, sophisticated British male AI assistant with composed cadence\',\n              },\n            },\n          ],\n        },\n      ],\n      config: {\n        responseModalities: [\'AUDIO\'],\n        speechConfig: {\n          voiceConfig: {\n            prebuiltVoiceConfig: { voiceName: \'Charon\' },\n          },\n        },\n      },\n    });\n\n    const base64Audio = ttsResponse.candidates?.[0]?.content?.parts?.[0]?.inlineData?.data;\n\n    if (base64Audio) {\n      res.json({\n        audio: `data:audio/wav;base64,${base64Audio}`,\n        fallbackToBrowser: false,\n      });\n    } else {\n      res.json({ audio: null, fallbackToBrowser: true });\n    }\n  } catch (err: any) {\n    console.warn(\'[J.A.R.V.I.S.] TTS API unavailable, falling back to browser speech:\', err?.message);\n    res.json({ audio: null, fallbackToBrowser: true });\n  }\n});\n\nasync function startServer() {\n  if (process.env.NODE_ENV === \'production\') {\n    app.use(express.static(path.resolve(__dirname, \'dist\')));\n    app.get(\'*\', (_req, res) => {\n      res.sendFile(path.resolve(__dirname, \'dist\', \'index.html\'));\n    });\n  } else {\n    const { createServer } = await import(\'vite\');\n    const vite = await createServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  }\n\n  app.listen(port, \'0.0.0.0\', () => {\n    console.log(`[J.A.R.V.I.S.] Core systems online on http://0.0.0.0:${port}`);\n  });\n}\n\nstartServer().catch((err) => {\n  console.error(\'[J.A.R.V.I.S.] Critical boot failure:\', err);\n  process.exit(1);\n});\n"
        path {
          absolute_uri: "file:///server.ts"
        }
        overwrite: true
      }
    }
